        <entry key="scriptBody" type="xstring" value="// Enter your code here:%%00010%%00010double muRejected = Math.max(%%00010        Math.max(Math.max(c_R_w1, c_R_w2), c_R_w3),%%00010        Math.max(Math.max(c_R_m1, c_R_m2), c_R_g1)%%00010    );%%00009%%00009%%00010double muAccepted = Math.max(%%00010        Math.max(c_R_w4, Math.max(c_R_m3, c_R_m4)),%%00010        Math.max(%%00010            Math.max(Math.max(c_R_g2, c_R_g3), c_R_g4),%%00010            Math.max(Math.max(c_R_s1, c_R_s2), Math.max(c_R_s3, c_R_s4))%%00010        )%%00010    );%%00010//Defuzzification%%00010double xmin = 0.0;%%00010double xmax = 10.0;%%00010int points = 100;%%00010%%00010double numerator = 0.0;%%00010double denominator = 0.0;%%00010%%00010for (int i = 0; i &lt; points; i++) {%%00010%%00010        double x = xmin + i * (xmax - xmin) / (points - 1);%%00010%%00010        double yRejected = 0.0;%%00010        double yAccepted = 0.0;%%00010%%00010        // -------- Rejected MF (0,0,2,7) --------%%00010        if (x &gt;= 0 &amp;&amp; x &lt;= 2) {%%00010            yRejected = 1.0;%%00010        } else if (x &gt; 2 &amp;&amp; x &lt;= 7) {%%00010            yRejected = (7 - x) / (7 - 2);%%00010        } else {%%00010            yRejected = 0.0;%%00010        }%%00010        yRejected = Math.min(yRejected, muRejected);%%00010%%00010        // -------- Accepted MF (3,8,10,10) --------%%00010        if (x &gt;= 3 &amp;&amp; x &lt; 8) {%%00010            yAccepted = (x - 3) / (8 - 3);%%00010        } else if (x &gt;= 8 &amp;&amp; x &lt;= 10) {%%00010            yAccepted = 1.0;%%00010        } else {%%00010            yAccepted = 0.0;%%00010        }%%00010        yAccepted = Math.min(yAccepted, muAccepted);%%00010%%00010        // -------- Mamdani aggregation --------%%00010        double mu = Math.max(yRejected, yAccepted);%%00010%%00010        numerator += mu * x;%%00010        denominator += mu;%%00010    }%%00010%%00010double decision = (denominator == 0) ? 0 : numerator / denominator;%%00010%%00010if (decision &lt; 4.9) {%%00010        out_Label  = &quot;Rejected&quot;;%%00010    } else {%%00010        out_Label  = &quot;Accepted&quot;;%%00010    }%%00010    %%00010out_Decision = decision;%%00010 %%00010"/>
